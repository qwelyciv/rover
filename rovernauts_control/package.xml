<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rovernauts_control</name>
  <version>1.0.0</version>
  <description>ROS2 Humble control, multiplexing, and telemetry package for LASER Rovernauts (UKSEDS Olympus Rover Trials 2025-26)[cite: 1]</description>
  <maintainer email="sgvlutsi@liverpool.ac.uk">Vitalii Lutsiv</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
